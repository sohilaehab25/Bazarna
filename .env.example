##############################################################
# .env.example  —  Frontend / SSR server environment template
# Copy to .env and fill in values before running.
# NEVER commit the real .env file.
##############################################################

# Node environment: development | staging | production
NODE_ENV=production

# Port the Angular SSR server listens on inside the container
PORT=4000

# Public URL of the backend API (used in Angular environments at build-time via server-side fetch)
API_URL=https://api.bazarna.com
