NODE_ENV=development
PORT=3001

# ── MongoDB ──────────────────────────────────────────────────
MONGODB_URI=mongodb://admin:changeme@localhost:27017/cute_bazar?authSource=admin
# App-level DB user (used by the running service, not the init script)
MONGO_APP_USER=bazarna_app
MONGO_APP_PASS=changeme_in_prod

# ── JWT ───────────────────────────────────────────────────────
# Use: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_64+_RANDOM_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64+_RANDOM_CHARS
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=2

# ── Email (SMTP) ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins
FRONTEND_URL=http://localhost:4200

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info
