NODE_ENV=development
PORT=3009

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017/cute_bazar

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=2

# Email Configuration (SMTP) - Required for email verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Frontend URL - Used in verification email links
FRONTEND_URL=http://localhost:4200

# Logging
LOG_LEVEL=info

# Paymob Payment Gateway
# Get these from: https://accept.paymob.com/portal2/en/settings
PAYMOB_API_KEY=your_paymob_api_key
PAYMOB_INTEGRATION_ID=your_integration_id
PAYMOB_IFRAME_ID=your_iframe_id
PAYMOB_HMAC_SECRET=your_hmac_secret
# Optional overrides (defaults shown):
# PAYMOB_BASE_URL=https://accept.paymob.com/api
# PAYMOB_CURRENCY=EGP